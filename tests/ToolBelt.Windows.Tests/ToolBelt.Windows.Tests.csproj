<Project Sdk="Microsoft.NET.Sdk">

  <!-- Hand-rolled, zero-dependency runner for the Windows platform satellite. Windows-only; exit 0 == all green. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ToolBelt.Windows.Tests</RootNamespace>
    <AssemblyName>ToolBelt.Windows.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolBelt.Windows\ToolBelt.Windows.csproj" />
  </ItemGroup>

  <!-- Reuse the zero-dependency test runner and assertions from the main suite rather than duplicating. -->
  <ItemGroup>
    <Compile Include="..\ToolBelt.Tests\Framework\Check.cs" Link="Framework\Check.cs" />
    <Compile Include="..\ToolBelt.Tests\Framework\TestRunner.cs" Link="Framework\TestRunner.cs" />
  </ItemGroup>

</Project>
