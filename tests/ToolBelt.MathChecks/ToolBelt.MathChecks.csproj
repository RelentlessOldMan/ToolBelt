<Project Sdk="Microsoft.NET.Sdk">

  <!-- Differential cross-check satellite. Grades ToolBelt's from-scratch numerics against a trusted
       third-party math library (Math.NET Numerics). This is the ONLY project in the repo with an
       external NuGet dependency, so it is deliberately EXCLUDED from ToolBelt.sln — the shipping
       library and its main test suite stay BCL-only. Run it explicitly with
       "dotnet run" against this project in Release configuration.
       Requires network access on first restore. The main suite's closed-form tests remain the
       authoritative check; this is a second, independent opinion on the trickier math. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ToolBelt.MathChecks</RootNamespace>
    <AssemblyName>ToolBelt.MathChecks</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolBelt\ToolBelt.csproj" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
  </ItemGroup>

  <!-- Reuse the zero-dependency test runner and assertions from the main suite rather than duplicating. -->
  <ItemGroup>
    <Compile Include="..\ToolBelt.Tests\Framework\Check.cs" Link="Framework\Check.cs" />
    <Compile Include="..\ToolBelt.Tests\Framework\TestRunner.cs" Link="Framework\TestRunner.cs" />
  </ItemGroup>

</Project>
