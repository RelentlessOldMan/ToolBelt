<Project Sdk="Microsoft.NET.Sdk">

  <!-- ToolBelt WinForms UI satellite (roadmap file 12C). Windows-only (net8.0-windows, WinForms): forms
       helpers (UI-thread marshalling, window-placement persistence). Separate from the core so the portable
       library never references a UI framework. Each file is a self-contained drop-in. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>ToolBelt.WinForms</RootNamespace>
    <AssemblyName>ToolBelt.WinForms</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: not every public member needs an XML doc comment (yet). -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
