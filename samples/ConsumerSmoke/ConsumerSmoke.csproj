<Project Sdk="Microsoft.NET.Sdk">

  <!-- A fresh, minimal EXTERNAL consumer of ToolBelt. It references only the shipped assembly and uses
       the public API surface — no access to internals or the test framework. Exercises the "pit of
       success" path plus deliberate misuse to confirm failures are clear. Not part of ToolBelt.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ConsumerSmoke</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolBelt\ToolBelt.csproj" />
  </ItemGroup>

</Project>
