<Project Sdk="Microsoft.NET.Sdk">

  <!-- Runs the ToolBelt.Diagnostics.Benchmark harness against a handful of hot-path utilities.
       Build in Release for meaningful numbers (dotnet run -c Release on this project). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ToolBelt\ToolBelt.csproj" />
  </ItemGroup>

</Project>
